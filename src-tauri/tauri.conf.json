{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AM8 Lab",
  "version": "0.6.7",
  "identifier": "local.am8lab.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AM8 Lab — Estúdio 0.6.7",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "AM8 Lab",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Controle experimental do DSP nativo do AM8 USB",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    }
  }
}
